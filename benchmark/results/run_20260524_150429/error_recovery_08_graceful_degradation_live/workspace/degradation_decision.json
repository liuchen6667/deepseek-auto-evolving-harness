{
  "order_mode": "reject",
  "chosen_strategies": ["reject_new_orders"],
  "rejected_strategies": [
    {"strategy": "async_payment", "reason": "payment-service down and not accepting new charges, policy disallows async payment"},
    {"strategy": "accept_without_inventory_reservation", "reason": "inventory-service readonly and cannot write reservations, policy requires writable inventory before order acceptance"},
    {"strategy": "manual_reconciliation_queue", "reason": "policy disallows manual reconciliation queue for new orders"}
  ],
  "degraded_flow": ["validate_request", "check_dependencies", "reject_due_to_payment_outage", "reject_due_to_inventory_readonly", "return_sync_response"],
  "consistency_guards": ["no_order_created", "no_payment_attempted", "no_inventory_reserved", "no_manual_reconciliation_required"],
  "recovery_plan": ["monitor_payment_service_recovery", "when_payment_healthy_resume_normal_checkout", "when_inventory_writable_resume_normal_checkout", "no_reconciliation_needed"],
  "user_response": {
    "http_status": 503,
    "status_code": "SERVICE_UNAVAILABLE",
    "must_return_within_seconds": 5
  },
  "evidence_refs": [
    "service_status.json",
    "checkout_request.json",
    "degradation_policy.yaml",
    "logs/checkout.log",
    "logs/notification.log",
    "runbook.md"
  ]
}